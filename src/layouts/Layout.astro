---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
}

const {
  title = "Agencia de Desarrollo de Software en Colombia | Nextzy Agency",
  description = "Agencia de desarrollo de software a medida en Colombia: aplicaciones web, plataformas SaaS y automatizaciones para empresas. Cotiza tu proyecto sin costo.",
  canonicalURL = Astro.url.href,
  ogImage = "/og-image.jpg",
} = Astro.props;

const site = "https://www.nextzyagency.online";

const schemaOrg = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "ProfessionalService"],
      "@id": `${site}/#organization`,
      name: "Nextzy Agency",
      url: `${site}/`,
      logo: {
        "@type": "ImageObject",
        url: `${site}/logos/nextzy-logo.svg`,
      },
      image: `${site}/og-image.jpg`,
      email: "nextzyagency@gmail.com",
      telephone: "+57-305-248-7564",
      address: {
        "@type": "PostalAddress",
        addressCountry: "CO",
      },
      contactPoint: {
        "@type": "ContactPoint",
        telephone: "+57-305-248-7564",
        email: "nextzyagency@gmail.com",
        contactType: "sales",
        areaServed: "CO",
        availableLanguage: "Spanish",
      },
      sameAs: [
        "https://www.instagram.com/nextzyautomations/",
        "https://github.com/nextzyagency",
      ],
      description:
        "Nextzy Agency es una agencia de desarrollo de software a medida en Colombia. Diseñamos y programamos aplicaciones web, plataformas SaaS, sistemas de gestión y automatizaciones para empresas de Colombia y Latinoamérica.",
      areaServed: [
        { "@type": "Country", name: "Colombia" },
        { "@type": "Place", name: "América Latina" },
      ],
      knowsAbout: [
        "Desarrollo de software a medida",
        "Desarrollo de aplicaciones web",
        "Plataformas SaaS",
        "Automatización de procesos",
        "Integración de APIs",
        "Sistemas de gestión empresarial",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${site}/#website`,
      url: `${site}/`,
      name: "Nextzy Agency",
      inLanguage: "es-CO",
      publisher: { "@id": `${site}/#organization` },
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalURL}#webpage`,
      url: canonicalURL,
      name: title,
      description,
      inLanguage: "es-CO",
      isPartOf: { "@id": `${site}/#website` },
      about: { "@id": `${site}/#organization` },
    },
    {
      "@type": "Service",
      "@id": `${site}/#services`,
      name: "Desarrollo de software a medida en Colombia",
      provider: { "@id": `${site}/#organization` },
      areaServed: { "@type": "Country", name: "Colombia" },
      serviceType: [
        "Desarrollo de aplicaciones web",
        "Desarrollo de plataformas SaaS",
        "Automatización de procesos e integraciones",
        "Software de gestión a medida",
      ],
      description:
        "Desarrollo de aplicaciones web, plataformas SaaS, sistemas de gestión y automatizaciones a medida para empresas en Colombia, con entregas semanales y soporte después del lanzamiento.",
    },
  ],
});
---

<!doctype html>
<html lang="es-CO" dir="ltr">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-JMJQRPK9J1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-JMJQRPK9J1');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="author" content="Nextzy Agency" />
    <meta
      name="keywords"
      content="agencia de desarrollo de software en Colombia, empresa de desarrollo de software, desarrollo de software a medida, desarrollo de aplicaciones web, desarrollo SaaS, automatización de procesos, Nextzy Agency"
    />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content={`https://www.nextzyagency.online${ogImage}`}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Nextzy Agency, agencia de desarrollo de software en Colombia"
    />
    <meta property="og:site_name" content="Nextzy Agency" />
    <meta property="og:locale" content="es_CO" />
    <meta name="geo.region" content="CO" />
    <meta name="geo.placename" content="Colombia" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={`https://www.nextzyagency.online${ogImage}`}
    />
    <meta
      name="twitter:image:alt"
      content="Nextzy Agency, agencia de desarrollo de software en Colombia"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Preconnect para performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Google Fonts con display=swap para no bloquear render -->
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Instrument+Serif:ital@0;1&family=Sora:wght@300;400;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={schemaOrg} />

    <!-- Meta Pixel Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1854766628466063');
      fbq('track', 'PageView');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=1854766628466063&ev=PageView&noscript=1"/>
    </noscript>
    <!-- End Meta Pixel Code -->
  </head>
  <body
    class="bg-nextzy-black text-nextzy-gray-300 font-sora antialiased overflow-x-hidden selection:bg-nextzy-purple selection:text-white flex flex-col min-h-screen relative"
  >
    <!-- Global Mouse Glow -->
    <div
      id="mouse-glow"
      aria-hidden="true"
      class="fixed inset-0 pointer-events-none transition-opacity duration-300 opacity-0 mix-blend-screen z-0"
      style="background: radial-gradient(circle 350px at var(--mouse-x, 50vw) var(--mouse-y, 50vh), rgba(138, 79, 255, 0.15), transparent 80%);"
    >
    </div>

    <main class="w-full relative z-10">
      <slot />
    </main>

    <script>
      const glow = document.getElementById("mouse-glow");

      window.addEventListener("mousemove", (e) => {
        if (glow) {
          glow.style.opacity = "1";
          glow.style.setProperty("--mouse-x", `${e.clientX}px`);
          glow.style.setProperty("--mouse-y", `${e.clientY}px`);
        }
      });

      document.addEventListener("mouseleave", () => {
        if (glow) glow.style.opacity = "0";
      });
    </script>
  </body>
</html>
