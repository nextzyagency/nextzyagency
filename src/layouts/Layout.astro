---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
}

const {
  title = "Nextzy Agency | Desarrollo de Software a Medida — Aplicaciones Web, SaaS y Automatizaciones",
  description = "Nextzy Agency desarrolla software a medida: aplicaciones web, plataformas SaaS, sistemas de gestión y automatizaciones que optimizan operaciones, escalan con tu negocio y te dan ventaja competitiva.",
  canonicalURL = Astro.url.href,
  ogImage = "/og-image.jpg",
} = Astro.props;

const schemaOrg = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.nextzyagency.online/#organization",
      name: "Nextzy Agency",
      url: "https://www.nextzyagency.online/",
      logo: {
        "@type": "ImageObject",
        url: "https://www.nextzyagency.online/logos/nextzy-logo.svg",
      },
      contactPoint: {
        "@type": "ContactPoint",
        telephone: "+57-305-248-7564",
        contactType: "customer service",
        availableLanguage: "Spanish",
      },
      sameAs: [
        "https://www.instagram.com/nextzyautomations/",
        "https://github.com/nextzyagency",
      ],
      description:
        "Agencia de desarrollo de software a medida especializada en aplicaciones web, plataformas SaaS, sistemas de gestión y automatizaciones que escalan con tu negocio.",
      areaServed: "América Latina",
      knowsAbout: [
        "Desarrollo de Software",
        "Aplicaciones Web",
        "SaaS",
        "Automatización",
        "APIs e Integraciones",
        "Desarrollo a Medida",
      ],
    },
    {
      "@type": "WebPage",
      "@id": "https://www.nextzyagency.online/#webpage",
      url: "https://www.nextzyagency.online/",
      name: "Nextzy Agency | Desarrollo de Software a Medida — Aplicaciones Web, SaaS y Automatizaciones",
      description:
        "Nextzy Agency desarrolla software a medida: aplicaciones web, plataformas SaaS, sistemas de gestión y automatizaciones que optimizan operaciones y escalan con tu negocio.",
      inLanguage: "es",
      isPartOf: { "@id": "https://www.nextzyagency.online/#organization" },
      about: { "@id": "https://www.nextzyagency.online/#organization" },
    },
    {
      "@type": "Service",
      "@id": "https://www.nextzyagency.online/#services",
      name: "Desarrollo de Software a Medida",
      provider: { "@id": "https://www.nextzyagency.online/#organization" },
      serviceType: ["Aplicación Web a Medida", "Plataforma SaaS", "Automatización e Integraciones", "Sistema de Gestión"],
      description:
        "Desarrollamos aplicaciones web, plataformas SaaS, sistemas de gestión y automatizaciones a medida con arquitectura escalable, código limpio y enfoque en resultados de negocio.",
    },
  ],
});
---

<!doctype html>
<html lang="es" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="author" content="Nextzy Agency" />
    <meta
      name="keywords"
      content="desarrollo de software a medida, agencia de software, desarrollo de aplicaciones web, SaaS, software a medida, automatización, integración de sistemas, desarrollo MVP, sistema de gestión, API, Nextzy Agency"
    />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content={`https://www.nextzyagency.online${ogImage}`}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Nextzy Agency - Desarrollo de Software a Medida"
    />
    <meta property="og:site_name" content="Nextzy Agency" />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={`https://www.nextzyagency.online${ogImage}`}
    />
    <meta
      name="twitter:image:alt"
      content="Nextzy Agency - Desarrollo de Software a Medida"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Preconnect para performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Google Fonts con display=swap para no bloquear render -->
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Instrument+Serif:ital@0;1&family=Sora:wght@300;400;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={schemaOrg} />

    <!-- Meta Pixel Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1854766628466063');
      fbq('track', 'PageView');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=1854766628466063&ev=PageView&noscript=1"/>
    </noscript>
    <!-- End Meta Pixel Code -->
  </head>
  <body
    class="bg-nextzy-black text-nextzy-gray-300 font-sora antialiased overflow-x-hidden selection:bg-nextzy-purple selection:text-white flex flex-col min-h-screen relative"
  >
    <!-- Global Mouse Glow -->
    <div
      id="mouse-glow"
      aria-hidden="true"
      class="fixed inset-0 pointer-events-none transition-opacity duration-300 opacity-0 mix-blend-screen z-0"
      style="background: radial-gradient(circle 350px at var(--mouse-x, 50vw) var(--mouse-y, 50vh), rgba(138, 79, 255, 0.15), transparent 80%);"
    >
    </div>

    <main class="w-full relative z-10">
      <slot />
    </main>

    <script>
      const glow = document.getElementById("mouse-glow");

      window.addEventListener("mousemove", (e) => {
        if (glow) {
          glow.style.opacity = "1";
          glow.style.setProperty("--mouse-x", `${e.clientX}px`);
          glow.style.setProperty("--mouse-y", `${e.clientY}px`);
        }
      });

      document.addEventListener("mouseleave", () => {
        if (glow) glow.style.opacity = "0";
      });
    </script>
  </body>
</html>
