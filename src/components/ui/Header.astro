---
// Header.astro
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { href: "/", label: "Inicio", title: "Ir al inicio", desktop: false },
  { href: "/#servicios", label: "Servicios", title: "Servicios de desarrollo de software", desktop: true },
  { href: "/portafolio", label: "Portafolio", title: "Portafolio de proyectos", desktop: true },
  { href: "/#proceso", label: "Proceso", title: "Nuestro proceso de desarrollo", desktop: true },
  { href: "/#capacidades", label: "Capacidades", title: "Capacidades y tecnologías", desktop: true },
  { href: "/#contacto", label: "Contacto", title: "Contactar a Nextzy Agency", desktop: false },
];

const isActive = (href: string) => href === pathname;
---

<header
  id="main-header"
  class="fixed top-4 md:top-6 left-1/2 -translate-x-1/2 w-[calc(100%-2rem)] md:w-[90%] max-w-5xl z-50"
>
  <div
    id="nav-bar"
    class="relative rounded-full pl-5 pr-2 py-2 flex items-center justify-between gap-4 bg-[#1f2229]/80 backdrop-blur-xl border border-white/10 shadow-[0_20px_40px_rgba(0,0,0,0.4)]"
  >
    <!-- Logo -->
    <a
      href="/"
      title="Nextzy Agency - Inicio"
      aria-label="Ir al inicio de Nextzy Agency"
      class="flex items-center gap-2.5 select-none shrink-0"
    >
      <svg
        class="h-8 md:h-9 w-auto"
        viewBox="96 400 284 226"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <defs>
          <linearGradient id="nx-header-arrow" x1="0" y1="1" x2="1" y2="0">
            <stop offset="0" stop-color="#5B0FC0" />
            <stop offset="1" stop-color="#A21CFF" />
          </linearGradient>
        </defs>
        <path fill="#e2e8f0" d="M107 619 Q102 619 103 614 L165 414 Q167 408 173 408 L234 408 Q240 408 242 413 L268 476 L212 537 L205 516 L170 614 Q168 619 163 619 Z" />
        <path fill="#e2e8f0" d="M252 590 L306 545 L336 613 Q337 619 331 619 L307 619 Q303 619 300 616 Z" />
        <path fill="url(#nx-header-arrow)" d="M172 619 Q186 620 194 612 L335 487 L355 494 L373 409 L281 425 L306 448 L172 592 Z" />
      </svg>
      <span class="flex flex-col items-start leading-none">
        <span class="font-bold text-lg md:text-xl tracking-tight text-[#e2e8f0] uppercase">Nextzy</span>
        <span class="text-[8px] md:text-[9px] text-gray-400 font-semibold tracking-[0.42em] uppercase mt-[3px]">Agency</span>
      </span>
    </a>

    <!-- Links (desktop) -->
    <nav
      aria-label="Navegación principal"
      class="hidden lg:flex items-center gap-1"
    >
      {
        links.filter((l) => l.desktop).map((l) => (
          <a
            href={l.href}
            title={l.title}
            aria-current={isActive(l.href) ? "page" : undefined}
            class:list={[
              "text-sm font-medium px-4 py-2 rounded-full transition-colors",
              isActive(l.href)
                ? "text-white bg-white/10"
                : "text-gray-400 hover:text-white hover:bg-white/5",
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <!-- CTA -->
      <a
        href="/#contacto"
        title="Cotizar proyecto de software a medida"
        class="hidden sm:inline-flex bg-[#8A4FFF] hover:bg-[#7b42ea] text-white text-sm font-medium py-2.5 px-6 rounded-full transition-colors shadow-[0_0_20px_rgba(138,79,255,0.3)] whitespace-nowrap"
      >
        Cotizar Proyecto
      </a>

      <!-- Menu toggle (mobile) -->
      <button
        id="menu-toggle"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="lg:hidden w-11 h-11 rounded-full flex items-center justify-center bg-white/5 border border-white/10 text-white hover:bg-white/10 transition-colors"
      >
        <span class="relative block w-5 h-3.5" aria-hidden="true">
          <span class="menu-line absolute left-0 top-0 w-5 h-[2px] rounded bg-current transition-all duration-300"></span>
          <span class="menu-line absolute left-0 top-1.5 w-5 h-[2px] rounded bg-current transition-all duration-300"></span>
          <span class="menu-line absolute left-0 top-3 w-5 h-[2px] rounded bg-current transition-all duration-300"></span>
        </span>
      </button>
    </div>
  </div>

  <!-- Menu (mobile) -->
  <div
    id="mobile-menu"
    hidden
    class="lg:hidden mt-3 rounded-3xl bg-[#15171d] border border-white/10 shadow-[0_20px_40px_rgba(0,0,0,0.5)] p-3 origin-top transition-[opacity,transform] duration-300 opacity-0 -translate-y-2 scale-95"
  >
    <nav aria-label="Navegación móvil" class="flex flex-col">
      {
        links.map((l) => (
          <a
            href={l.href}
            title={l.title}
            aria-current={isActive(l.href) ? "page" : undefined}
            class:list={[
              "mobile-link flex items-center justify-between px-4 py-3.5 rounded-2xl text-base font-medium transition-colors",
              isActive(l.href)
                ? "text-white bg-white/10"
                : "text-gray-300 hover:text-white hover:bg-white/5",
            ]}
          >
            {l.label}
            <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </a>
        ))
      }
    </nav>
    <a
      href="/#contacto"
      title="Cotizar proyecto de software a medida"
      class="mobile-link sm:hidden mt-2 flex justify-center bg-[#8A4FFF] hover:bg-[#7b42ea] text-white text-base font-medium py-3.5 rounded-2xl transition-colors shadow-[0_0_20px_rgba(138,79,255,0.3)]"
    >
      Cotizar Proyecto
    </a>
  </div>
</header>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const navBar = document.getElementById("nav-bar");

  if (navBar) {
    ScrollTrigger.create({
      start: "top -50px",
      end: 99999,
      onEnter: () =>
        gsap.to(navBar, {
          backgroundColor: "rgba(21, 25, 33, 0.95)",
          duration: 0.3,
        }),
      onLeaveBack: () =>
        gsap.to(navBar, {
          backgroundColor: "rgba(31, 34, 41, 0.8)",
          duration: 0.3,
        }),
    });
  }

  // Mobile menu
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const lines = toggle?.querySelectorAll<HTMLElement>(".menu-line");
  const closedClasses = ["opacity-0", "-translate-y-2", "scale-95"];
  let closeTimer: number | undefined;

  const setMenu = (open: boolean) => {
    if (!toggle || !menu || !lines) return;
    if ((toggle.getAttribute("aria-expanded") === "true") === open) return;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    window.clearTimeout(closeTimer);
    if (open) {
      // Fuera del render mientras está cerrado; se muestra y luego se anima
      menu.hidden = false;
      requestAnimationFrame(() =>
        requestAnimationFrame(() => closedClasses.forEach((c) => menu.classList.remove(c)))
      );
    } else {
      closedClasses.forEach((c) => menu.classList.add(c));
      closeTimer = window.setTimeout(() => (menu.hidden = true), 300);
    }
    lines[0].style.transform = open ? "translateY(6px) rotate(45deg)" : "";
    lines[1].style.opacity = open ? "0" : "";
    lines[2].style.transform = open ? "translateY(-6px) rotate(-45deg)" : "";
  };

  toggle?.addEventListener("click", () => {
    setMenu(toggle.getAttribute("aria-expanded") !== "true");
  });

  menu?.querySelectorAll(".mobile-link").forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setMenu(false);
  });

  document.addEventListener("click", (e) => {
    const header = document.getElementById("main-header");
    if (header && !header.contains(e.target as Node)) setMenu(false);
  });

  window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
    if (e.matches) setMenu(false);
  });
</script>
