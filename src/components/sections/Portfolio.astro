---
// Portfolio.astro — Proyectos terminados (home)
import { Image } from "astro:assets";
import { finishedProjects } from "../../data/portafolio";
---

<section
  id="portafolio"
  class="relative w-full py-24 md:py-32 overflow-hidden"
>
  <!-- Background glows -->
  <div
    class="absolute top-1/3 left-0 w-[500px] h-[500px] bg-purple-900/20 blur-[140px] rounded-full pointer-events-none"
  ></div>

  <div class="relative z-10 w-full max-w-7xl mx-auto px-6">

    <!-- Section header -->
    <div class="text-center max-w-2xl mx-auto mb-16 port-header">
      <div
        class="inline-block text-[#8A4FFF] font-mono tracking-widest uppercase text-xs font-semibold border border-[#8A4FFF]/30 bg-[#8A4FFF]/10 px-4 py-2 rounded-full backdrop-blur-sm mb-6"
      >
        Portafolio
      </div>
      <h2
        class="text-4xl md:text-5xl lg:text-6xl font-black tracking-tighter text-white mb-5 leading-tight"
      >
        Proyectos <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-[#8A4FFF] to-[#b68ef8]"
          >en producción</span
        >
      </h2>
      <p class="text-gray-400 text-lg leading-relaxed">
        Sitios web que diseñamos y desarrollamos para clínicas en Colombia. Ambos están en línea y puedes visitarlos.
      </p>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch port-cards">
      {
        finishedProjects.map((p) => (
          <article class="group h-full flex flex-col rounded-3xl overflow-hidden border border-white/10 bg-[#0d0d10] transition-all duration-500 hover:border-[#8A4FFF]/50 hover:shadow-[0_0_60px_rgba(138,79,255,0.15)]">

            <!-- Preview -->
            <a
              href={p.url}
              target="_blank"
              rel="noopener noreferrer"
              title={`Ver sitio de ${p.name}`}
              class="relative block aspect-[16/10] overflow-hidden border-b border-white/10"
            >
              <Image
                src={p.image}
                alt={`Captura del sitio web de ${p.name}`}
                widths={[480, 800, 1200]}
                sizes="(min-width: 768px) 600px, 100vw"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
              />
              <span class="absolute bottom-4 left-4 text-[10px] font-mono uppercase tracking-widest text-emerald-300 bg-black/70 border border-emerald-400/30 px-3 py-1 rounded-full backdrop-blur-sm">
                ● En producción
              </span>
            </a>

            <div class="flex flex-col gap-5 p-8 flex-1">
              <div>
                <p class="text-[10px] font-mono text-[#8A4FFF] uppercase tracking-widest mb-2">
                  {p.category}
                </p>
                <h3 class="text-2xl font-black text-white tracking-tight">
                  {p.name}
                </h3>
              </div>

              <p class="text-gray-400 text-sm leading-relaxed">{p.summary}</p>

              <div class="flex flex-wrap gap-2">
                {p.tags.map((tag) => (
                  <span class="text-xs text-gray-400 bg-white/5 border border-white/10 px-3 py-1 rounded-full">
                    {tag}
                  </span>
                ))}
              </div>

              <a
                href={p.url}
                target="_blank"
                rel="noopener noreferrer"
                title={`Visitar ${p.name}`}
                class="mt-auto inline-flex items-center gap-2 text-sm font-medium text-[#b68ef8] hover:text-white transition-colors"
              >
                Visitar sitio
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                </svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Link al portafolio completo -->
    <div class="flex justify-center mt-14 port-more">
      <a
        href="/portafolio"
        title="Ver portafolio completo de Nextzy Agency"
        class="inline-flex items-center gap-2 bg-white/5 hover:bg-[#8A4FFF] border border-white/15 hover:border-[#8A4FFF] text-white text-sm font-medium py-3 px-7 rounded-full transition-colors"
      >
        Ver portafolio completo
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>

  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    gsap.fromTo(
      ".port-header",
      { y: 30, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 1,
        ease: "power3.out",
        scrollTrigger: { trigger: "#portafolio", start: "top 80%" },
      }
    );

    gsap.fromTo(
      ".port-cards > article",
      { y: 50, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.9,
        stagger: 0.15,
        ease: "power2.out",
        scrollTrigger: { trigger: ".port-cards", start: "top 90%" },
      }
    );
  });
</script>
