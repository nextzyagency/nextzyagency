---
// Process.astro

const steps = [
  {
    num: "01",
    label: "Descubrimiento",
    desc: "Entendemos tu negocio, tus procesos actuales y el problema real que el software debe resolver.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 0 1-.825-.242m9.345-8.334a2.126 2.126 0 0 0-.476-.095 48.64 48.64 0 0 0-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0 0 11.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" />`
  },
  {
    num: "02",
    label: "Arquitectura",
    desc: "Definimos la estructura, tecnologías, base de datos y flujos antes de escribir la primera línea de código.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 3.104v5.714a2.25 2.25 0 0 1-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 0 1 4.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.05 14.5M14.25 3.104c.251.023.501.05.75.082M19.05 14.5l-4.124 4.124a2.25 2.25 0 0 1-1.591.659H10.66a2.25 2.25 0 0 1-1.591-.659L5 14.5m14.05 0L12 21.5 5 14.5" />`
  },
  {
    num: "03",
    label: "Desarrollo",
    desc: "Construimos de forma ágil con entregas semanales. Ves el avance real y validas cada funcionalidad.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />`
  },
  {
    num: "04",
    label: "QA & Deploy",
    desc: "Probamos cada flujo, optimizamos rendimiento y desplegamos en producción con infraestructura confiable.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />`
  },
  {
    num: "05",
    label: "Evolución",
    desc: "Tu software no se queda quieto. Agregamos funciones, integramos herramientas y escalamos contigo.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182" />`
  }
];
---

<section id="proceso" class="w-full relative py-20 px-6 overflow-hidden">
  <div class="max-w-7xl mx-auto relative z-10">

    <!-- Encabezado -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-20 process-header">
      <div class="text-[#8A4FFF] font-mono mb-6 tracking-widest uppercase text-sm font-semibold border border-[#8A4FFF]/30 bg-[#8A4FFF]/10 px-4 py-2 rounded-full inline-block">
        // Proceso de Trabajo
      </div>
      <h2 class="text-[clamp(2rem,4vw,3.5rem)] font-black leading-tight tracking-tighter text-white uppercase">
        Así convertimos tu idea en<br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#A78BFA] to-[#7C3AED] filter drop-shadow-[0_0_15px_rgba(138,79,255,0.3)]">software que funciona</span>
      </h2>
    </div>

    <!-- Contenedor del Proceso -->
    <div class="relative max-w-6xl mx-auto">

      <!-- Línea Conectora Desktop -->
      <div class="absolute top-10 left-[5%] w-[90%] h-[2px] bg-gradient-to-r from-[#8A4FFF]/0 via-[#8A4FFF]/60 to-[#8A4FFF]/0 hidden lg:block process-line-desktop"></div>

      <!-- Línea Conectora Mobile -->
      <div class="absolute top-[3%] left-1/2 -translate-x-1/2 w-[2px] h-[94%] bg-gradient-to-b from-[#8A4FFF]/0 via-[#8A4FFF]/60 to-[#8A4FFF]/0 lg:hidden process-line-mobile"></div>

      <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-4">
        {steps.map((step) => (
          <div class="relative flex flex-col items-center text-center process-item">

            <!-- Círculo con icono -->
            <div class="w-20 h-20 rounded-full border border-[#8A4FFF]/40 bg-[#0d1219] flex items-center justify-center z-10 mb-6 drop-shadow-[0_0_24px_rgba(138,79,255,0.25)] group-hover:scale-105 transition-transform duration-300">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-8 h-8 text-[#8A4FFF]"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
                set:html={step.icon}
              ></svg>
            </div>

            <!-- Número -->
            <span class="text-xs font-mono text-[#8A4FFF]/60 tracking-widest uppercase mb-1">{step.num}</span>

            <!-- Título -->
            <h3 class="text-lg font-bold text-white uppercase tracking-tight mb-2">{step.label}</h3>

            <!-- Descripción -->
            <p class="text-sm text-gray-400 font-medium leading-relaxed max-w-[170px] mx-auto">
              {step.desc}
            </p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Encabezado
  gsap.fromTo('.process-header',
    { y: 40, opacity: 0 },
    {
      y: 0,
      opacity: 1,
      duration: 1,
      ease: 'power3.out',
      scrollTrigger: { trigger: '.process-header', start: 'top 85%' }
    }
  );

  // Items en cascada
  const items = gsap.utils.toArray('.process-item');
  items.forEach((item: any, i) => {
    gsap.fromTo(item,
      { y: 50, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.7,
        delay: i * 0.15,
        ease: 'power3.out',
        scrollTrigger: { trigger: item, start: 'top 88%' }
      }
    );
  });

  // Línea horizontal desktop
  gsap.fromTo('.process-line-desktop',
    { scaleX: 0, opacity: 0, transformOrigin: 'left center' },
    {
      scaleX: 1,
      opacity: 1,
      duration: 1.5,
      ease: 'power2.out',
      scrollTrigger: { trigger: '.process-line-desktop', start: 'top 80%' }
    }
  );

  // Línea vertical mobile
  gsap.fromTo('.process-line-mobile',
    { scaleY: 0, opacity: 0, transformOrigin: 'top center' },
    {
      scaleY: 1,
      opacity: 1,
      duration: 1.5,
      ease: 'power2.out',
      scrollTrigger: { trigger: '.process-line-mobile', start: 'top 80%' }
    }
  );
</script>
