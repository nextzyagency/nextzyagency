---
// Testimonials.astro — Capacidades / Stack (reemplaza Proyectos Anteriores)
const capabilities = [
  {
    category: "Frontend & Experiencia",
    name: "Interfaces que convierten",
    icon: "M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0H3",
    tags: ["Next.js", "Astro", "Tailwind", "GSAP"],
    description:
      "Diseñamos interfaces rápidas, accesibles y centradas en el usuario. Desde dashboards complejos hasta plataformas SaaS con experiencia premium en móvil y desktop.",
  },
  {
    category: "Backend & Datos",
    name: "Sistemas robustos",
    icon: "M20.25 6.75V4.5m0 2.25h-7.5m7.5 0l-1 1.26m-3.75 9.75 1-1.26m0 0h7.5m-7.5 0v2.25m0-2.25H12m2.25 0V12m0 0V9.75M12 12v2.25m0-2.25h-1.5m1.5 0l1-1.26M12 12l-1 1.26M12 12V9.75m0 0V7.5m0 2.25H10.5m1.5 0l-1-1.26M12 9.75l1 1.26M10.5 9.75 12 12m0 0v2.25",
    tags: ["Node.js", "PostgreSQL", "Supabase", "APIs REST"],
    description:
      "Bases de datos bien modeladas, APIs seguras y lógica de negocio escalable. Tu información organizada, protegida y lista para crecer sin fricción.",
  },
  {
    category: "Automatización & Integraciones",
    name: "Flujos que trabajan solos",
    icon: "M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z",
    tags: ["n8n", "WhatsApp API", "Webhooks", "CRM"],
    description:
      "Conectamos tus herramientas para que hablen entre sí. Desde notificaciones automáticas hasta sincronización de datos en tiempo real sin intervención manual.",
  },
  {
    category: "Cloud & Deploy",
    name: "Infraestructura confiable",
    icon: "M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.5 4.5 0 002.25 15z",
    tags: ["Cloudflare", "Vercel", "CI/CD", "99.9% Uptime"],
    description:
      "Despliegues continuos, backups automáticos y monitoreo. Tu software siempre disponible, rápido y seguro, sin que te preocupes por la infraestructura.",
  },
];
---

<section
  id="capacidades"
  class="relative w-full py-24 md:py-32 overflow-hidden"
>
  <!-- Background glows -->
  <div
    class="absolute top-1/2 right-0 w-[500px] h-[500px] bg-purple-900/20 blur-[140px] -translate-y-1/2 rounded-full pointer-events-none"
  ></div>
  <div
    class="absolute bottom-0 left-0 w-64 h-64 bg-purple-900/15 blur-[100px] rounded-full pointer-events-none"
  ></div>

  <div class="relative z-10 w-full max-w-7xl mx-auto px-6">

    <!-- Section header -->
    <div class="text-center max-w-2xl mx-auto mb-16 proj-header">
      <div
        class="inline-block text-[#8A4FFF] font-mono tracking-widest uppercase text-xs font-semibold border border-[#8A4FFF]/30 bg-[#8A4FFF]/10 px-4 py-2 rounded-full backdrop-blur-sm mb-6"
      >
        Capacidades técnicas
      </div>
      <h2
        class="text-4xl md:text-5xl lg:text-6xl font-black tracking-tighter text-white mb-5 leading-tight"
      >
        Tecnología que <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-[#8A4FFF] to-[#b68ef8]"
          >resuelve problemas</span
        >
      </h2>
      <p class="text-gray-400 text-lg leading-relaxed">
        Stack moderno, buenas prácticas y arquitectura pensada para que tu software sea rápido, seguro y fácil de escalar.
      </p>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch proj-cards">
      {
        capabilities.map((c) => (
          <article class="group h-full flex flex-col rounded-3xl overflow-hidden border border-white/10 bg-[#0d0d10] transition-all duration-500 hover:border-[#8A4FFF]/50 hover:shadow-[0_0_60px_rgba(138,79,255,0.15)]">

            <!-- Color accent bar -->
            <div class="h-[3px] w-full bg-gradient-to-r from-[#8A4FFF] to-[#b68ef8] opacity-60 group-hover:opacity-100 transition-opacity duration-500" />

            <div class="flex flex-col gap-6 p-8 flex-1">

              <!-- Icon + Identity -->
              <div class="flex items-start justify-between gap-4">
                <div class="flex gap-4">
                  <div class="w-12 h-12 rounded-xl bg-[#8A4FFF]/10 border border-[#8A4FFF]/20 flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6 text-[#8A4FFF]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={c.icon} />
                    </svg>
                  </div>
                  <div>
                    <p class="text-[10px] font-mono text-[#8A4FFF] uppercase tracking-widest mb-2">
                      {c.category}
                    </p>
                    <h3 class="text-xl font-black text-white tracking-tight">
                      {c.name}
                    </h3>
                  </div>
                </div>
              </div>

              <!-- Tags -->
              <div class="flex flex-wrap gap-2">
                {c.tags.map((tag) => (
                  <span class="text-xs text-gray-400 bg-white/5 border border-white/10 px-3 py-1 rounded-full">
                    {tag}
                  </span>
                ))}
              </div>

              <!-- Description -->
              <p class="text-gray-400 text-sm leading-relaxed">{c.description}</p>

            </div>
          </article>
        ))
      }
    </div>

  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    gsap.fromTo(
      ".proj-header",
      { y: 30, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 1,
        ease: "power3.out",
        scrollTrigger: { trigger: "#capacidades", start: "top 80%" },
      }
    );

    gsap.fromTo(
      ".proj-cards > article",
      { y: 50, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.9,
        stagger: 0.15,
        ease: "power2.out",
        scrollTrigger: { trigger: ".proj-cards", start: "top 90%" },
      }
    );
  });
</script>
