---
import Layout from '../layouts/Layout.astro';
import Header from '../components/ui/Header.astro';
import Hero from '../components/sections/Hero.astro';
import SocialProof from '../components/sections/SocialProof.astro';
import Services from '../components/sections/Services.astro';
import Features from '../components/sections/Features.astro';
import Portfolio from '../components/sections/Portfolio.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Process from '../components/sections/Process.astro';
import MisionVision from '../components/sections/MisionVision.astro';
import Cta from '../components/sections/Cta.astro';

import Footer from '../components/sections/Footer.astro';
---

<Layout
  title="Nextzy Agency | Desarrollo de Software a Medida — Aplicaciones Web, SaaS y Automatizaciones"
  description="Nextzy Agency desarrolla software a medida: aplicaciones web, plataformas SaaS, sistemas de gestión y automatizaciones que optimizan operaciones, escalan con tu negocio y te dan ventaja competitiva."
>
  <Header />
  <main class="w-full">
    <Hero />
    <SocialProof />
    <Services />
    <Features />
    <Portfolio />
    <Testimonials />
    <Process />
    <MisionVision />
    <Cta />

  </main>
  <Footer />
</Layout>
